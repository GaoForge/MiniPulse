#include <windows.h>

1 ICON "assets/MiniPulse.ico"
1 RT_MANIFEST "MiniPulse.manifest"

1 VERSIONINFO
FILEVERSION 1,6,5,0
PRODUCTVERSION 1,6,5,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MiniPulse contributors\0"
            VALUE "FileDescription", "MiniPulse native resource monitor\0"
            VALUE "FileVersion", "1.6.5\0"
            VALUE "InternalName", "MiniPulse\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 MiniPulse contributors. MIT License.\0"
            VALUE "OriginalFilename", "MiniPulse.exe\0"
            VALUE "ProductName", "MiniPulse\0"
            VALUE "ProductVersion", "1.6.5\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
